<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- turkos.umea.se upstreams nuget.org and the basicUse (Umea.se) feed, so it serves every
         Umea.* package on its own. In CI the NuGetAuthenticate task's credential provider
         authenticates this feed by URL (umeakommun.pkgs.visualstudio.com), so no feed-* alias is
         needed. -->
    <add key="turkos.umea.se" value="https://umeakommun.pkgs.visualstudio.com/_packaging/turkos.umea.se/nuget/v3/index.json" />
  </packageSources>
  <!-- packageSourceMapping keys MUST match the <packageSource> keys above exactly. Do not add
       feed-* keys: the restore task materialises a feed-<key> source per internal feed, and a
       matching feed-* mapping key makes it generate that source twice, which newer NuGet rejects
       with "multiple package sources associated with the same key". -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="turkos.umea.se">
      <package pattern="Umea.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

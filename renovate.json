{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Ignore @turkos packages — updated manually",
      "matchPackageNames": ["/^@turkos\\//"],
      "enabled": false
    },
    {
      "description": "Group all NuGet updates into one PR",
      "matchManagers": ["nuget"],
      "groupName": "All NuGet updates"
    },
    {
      "description": "Group all npm updates into one PR",
      "matchManagers": ["npm"],
      "groupName": "All npm updates"
    }
  ]
}

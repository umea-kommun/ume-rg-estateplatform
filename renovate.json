{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Ignore @turkos packages — updated manually",
      "matchPackageNames": ["/^@turkos\\//"],
      "enabled": false
    },
    {
      "description": "Group all NuGet updates into one PR",
      "matchManagers": ["nuget"],
      "groupName": "NuGet packages"
    },
    {
      "description": "Group all npm updates into one PR",
      "matchManagers": ["npm"],
      "groupName": "npm packages"
    },
    {
      "description": "Label non-major group PRs, matching the (major) suffix",
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessageSuffix": "(minor)"
    }
  ]
}

# Vars must begin with "VUE_APP"
#
# Every variable here is read by the app - see src/Config.ts. Adding one that
# nothing reads is how the 81-variable file this was extracted from happened.

# Auth
# The portal has exactly one login client: internal AD via IDProxy. AuthConfig.ts
# treats VUE_APP_AUTH_INTERNAL_* as the internal client by prefix, so the prefix
# is load-bearing - see plugins/auth/AuthConfig.ts.
VUE_APP_AUTH_CLASS = Oauth
VUE_APP_AUTH_SCOPE_INTERNAL = internal:mypage
VUE_APP_AUTH_INTERNAL_CLIENT_ID = MyPageInternal
VUE_APP_AUTH_INTERNAL_CLIENT_NAME = MyPage Internal
VUE_APP_AUTH_INTERNAL_CLIENT_DISPLAY_NAME = "Fortsätt som anställd i Umeå kommun"
VUE_APP_AUTH_INTERNAL_CLIENT_LOGO = /assets/Kommunlovet.svg
VUE_APP_AUTH_INTERNAL_CLIENT_SECRET = nosecret
VUE_APP_AUTH_INTERNAL_AUTHORITY_URL = https://authtokendev.umea.se
VUE_APP_AUTH_INTERNAL_REDIRECT_URL = http://localhost:8080/oauthCallback
VUE_APP_AUTH_INTERNAL_LOGOUT_URL = https://authtokendev.umea.se/api/v1.0/sso/logout

# Allowed idle time before automatic log out
VUE_APP_INACTIVITY_TIME_LIMIT = 20

# Snackbar timeout, how long will it show
VUE_APP_SNACKBAR_TIMEOUT = 20000

# Locale
VUE_APP_I18N_LOCALE=sv
VUE_APP_I18N_FALLBACK_LOCALE=sv

# Appinsight
VUE_APP_APPINSIGHT_CONNECTION_STRING = ""
VUE_APP_CLOUD_ROLE_NAME = ""

# Footer and error-page links
VUE_APP_UMEA_SE_URL =  https://www.umea.se/
VUE_APP_ABOUT_URL =  https://www.umea.se/kommunochpolitik/kommunfakta/kommunensmal/eservicevision.4.7d7d901172bb372c5d48a.html
VUE_APP_COOKIE_URL = https://www.umea.se/kommunochpolitik/kommunfakta/kommunensmal/eservicevision.4.7d7d901172bb372c5d48a.html
VUE_APP_ERROR_REPORT_URL = https://e.umea.se/medborgare-rapportera-tekniskt-fel-i-etjanst
VUE_APP_AVAILABILITY_STATEMENT_URL = https://e.umea.se/tillganglighet

# EstateService - the only backend this app talks to
VUE_APP_ESTATE_SERVICE = https://ume-app-estateservice-dev.azurewebsites.net/api/v1.0

# Meta tags
VUE_APP_ROBOTS_META=<meta name="robots" content="noindex,nofollow">
